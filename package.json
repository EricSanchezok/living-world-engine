    "retrieval:cache:verify": "tsx scripts/operations/retrieval-cache-command.ts verify",
    "retrieval:cache:status": "tsx scripts/operations/retrieval-cache-command.ts status",
    "retrieval:cache:rebuild": "tsx scripts/operations/retrieval-cache-command.ts rebuild",
    "benchmark:train:action-compilation-reranker": "tsx scripts/experiments/train-action-compilation-reranker.ts",
