    "test:live:glm": "tsx scripts/operations/smoke-world.ts --profile-set glm",
    "test:live:glm:batching": "tsx scripts/operations/smoke-world.ts --profile-set glm --batching-only",
    "test:live:deepseek": "tsx scripts/operations/smoke-world.ts --profile-set deepseek",
    "test:live:deepseek:batching": "tsx scripts/operations/smoke-world.ts --profile-set deepseek --batching-only",
    "test:live:qwen": "tsx scripts/operations/smoke-world.ts --profile-set qwen",
    "test:live:qwen:batching": "tsx scripts/operations/smoke-world.ts --profile-set qwen --batching-only",
    "verify:prompts": "node scripts/verify-prompt-assets.mjs",
    "verify:algorithms": "node scripts/verify-algorithms.mjs",
    "check:fast": "npm run lint && npm run typecheck && npm run test && npm run verify:prompts && npm run verify:algorithms && npm run world:validate -- test/fixtures/open-world-script && node scripts/verify-debug-contract.mjs && node scripts/verify-workflow-scripts.mjs && node scripts/run-gates.mjs",
