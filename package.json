    "experiment:action-compilation:v3": "tsx scripts/experiments/action-compilation-semantic-first-pass.ts",
    "experiment:action-compilation:semantic-audit": "tsx scripts/experiments/audit-action-compilation-semantics.ts",
    "execution:replay": "tsx scripts/operations/execution-command.ts replay",
    "execution:compare": "tsx scripts/operations/execution-command.ts compare",
    "execution:export": "tsx scripts/operations/execution-command.ts export",
    "debug": "tsx scripts/operations/debug-command.ts",
    "debug:doctor": "tsx scripts/operations/debug-command.ts doctor",
