  "laws": [
    {
      "id": "global-detail-mortal-herb-supply",
      "text": "常用凡俗药材可培育，珍稀高龄草药通常更难获得，野采需真实地理与风险；世家长期种植、收购不使所有世家自动拥有百年药。黄龙草、苦莲花、忘忧果、三乌草属于可辨药草，药性与年龄须依据具体植株；名称、配方或传闻不生成植株、年限和库存。",
      "severity": "hard"
    },
    {
      "id": "global-detail-remedy-treatment-limits",
      "text": "黄龙丹、金髓丸须服炼才可能助益适合的低阶功力，不直接授予境界；药力跟不上境界与长期服用失效分别判断。清灵散能解多种毒却不是万能解药，尸虫不因服此药便自动消失。养精丹可显著缓和内外伤、止血与促进恢复，但不能起死回生；具体伤势、药量和病因仍需判断。",
      "severity": "hard"
    },
    {
      "id": "global-detail-mixed-poison-response",
      "text": "缠香丝须实际配制并入体，初期妄运内家真气会促毒；久留入骨可造成严重萎缩并需对症药持续抑制。可替材料使毒性与解药不同，不能仅会一张通方便自动解另一制法。本文凡俗难解不排除后续确有依据的高阶救治；中毒威胁不强改人的意志。土菇花有毒且能妨碍普通离体元神施术，实际强弱、剂量与防护须核，不保证对一切境界神魂必杀。",
      "severity": "hard"
    },
    {
      "id": "global-detail-seven-ghost-expenditure",
      "text": "施七鬼噬魂大法需要真实备妥相应银刃和仪式条件，以施者身体及精元供养，暂获法力与简单法术能力；不永久返龄、不凭宣言补满精元。能否重施受剩余生命精元与伤势制约。具体七刃必须在世界有实物来源，知道术名不生成器具。",
      "severity": "hard"
    },
    {
      "id": "global-detail-basic-fire-conditions",
      "text": "已学火弹术者需实际施法凝成小火球并用法力推动；可产生熔伤普通精钢的高温，落水不必自然熄灭，但不能由此保证破一切水系禁术或护盾。范围、控制、修为和剩余法力影响结果，持球近战也必须实际控制且承担距离风险。",
      "severity": "hard"
    },
    {
      "id": "global-detail-basic-wind-conditions",
      "text": "已学御风诀者将辅助术施于自身，以持续微量法力支持加速奔行，并代替这段奔行的常规体力负担；法力耗尽或停止施法即失加速。此诀不能直接加持另一人，也不能跳过路径、障碍或移动时间。",
      "severity": "hard"
    },
    {
      "id": "global-detail-control-spell-qualification",
      "text": "旧入门控物/驱物口诀要求相配的可驱对象及有效施法；普通家具刀剑和各种法器不能仅凭同一口诀自动驱使。新获得器物需要辨认并掌握对应驱法；此初学限制不构成禁止一切高阶搬运、御物或神通的普遍铁律。",
      "severity": "hard"
    },
    {
      "id": "global-detail-letter-reagent-use",
      "text": "四种现形粉须实际从各自容器取出，用真实水混合，再涂相应暗信并烘干；已消耗的粉不能再次使用，需有配方材料才能补制。只持戒/知信号不自动读出消息，更不能得到寄信者此后的真实状态。",
      "severity": "hard"
    },
    {
      "id": "global-detail-mortal-drug-and-charm-resistance",
      "text": "凡俗魅惑与迷药依施术、吸入或摄入、剂量、体质、精神力和防护实际生效，不因名称或威吓就强制服从、倒地或死亡。千人醉可暂致乏力与内家真气失灵，确有预防手段；笑魂散有致死毒性但不能把对凡人的实例扩成无视一切修士防护。黄栗丸是鸟食药、萦香丸用于香与避蚊，均须有真实来源与有限用量。",
      "severity": "hard"
    },
    {
      "id": "global-detail-bell-delegated-use",
      "text": "引魂钟在已确立血主并连结那具炼尸时，可由持钟者受托驱使；交付保管不自动改变血主。原血主仍活着时旁人不能只在钟上做手脚便夺得控制；作用仍受距离、遮蔽与真实器具状态限制。这项特殊方法不概括所有法宝，也不能据此把活人当炼尸控制。",
      "severity": "hard"
    },
    {
      "id": "global-detail-talisman-type-and-charge",
      "text": "金刚符为金属性初级中阶防御符；飞天符为风属性初级上阶飞行符，灵力未散时可再次使用，耗尽不得凭名字自动续航。实际施符仍需会对应方法，防御和逃离不保证成功。基础地刺术属初级中阶，残本、完整五行咒书等是不同传本，持有一本不等掌握全部法术。具体摊位标价不成为全界永久价目。",
      "severity": "hard"
    }
  ],
