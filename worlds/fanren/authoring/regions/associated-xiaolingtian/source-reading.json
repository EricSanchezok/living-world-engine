  "paidModelCalls": 0,
  "findings": [
    "小灵天与广寒界不同，仙界泛称小灵界不能自动同指。",
    "绿海是森林，火山/丘地/毒沼分属不同族群。",
    "古坛测算、坐标精度、入口状态和实际承压分别判断。",
    "太玄/天玄为同段异文；凌飞仙/石纤云连续母女指代保持版本冲突。",
    "人族三男一女与更多外貌指代不强合；铁钧和白翁的精确同一性不擅定。",
    "迁民是百余人，雪松兽所得无名丹不能直接写为开元丹。",
    "原著后来的罗睺尸体、晶核、战争和南宫婉居留均不初始化。"
  ],
  "boundedQuestions": [
    "确切母名与人族议事者对应，缺独立版本证据。",
    "后期人物的开篇生年/位置未定，索引保留但不生成确定T0角色。",
    "七八异族中的未命名族群不可伪造原著名称。"
  ],
  "originalChoices": [
    "18位在地人物、当前合作/利益冲突和实际工具库存。",
    "灰珊海岭休眠入口与两古坛当前损坏程度。",
    "测算窗口、资源费用、寄附消耗与交通细路。"
  ]
}
