  "laws": [
    {
      "id": "immortal-external-boundary",
      "text": "仙界不开放探索；外部历史与势力索引不自动成为可访问地点、公共人物知识、现成传送门或召唤权限。九元观后来追捕、马良降界与血祭不得按小说章节或固定日期强制发生。",
      "severity": "hard"
    },
    {
      "id": "immortal-conditional-crossing",
      "text": "界面失联不等于一切特殊跨界物理不可能；常规降界和跨界通讯需要真实目标、权限、媒介、资源和能力。特殊宝符或法器只具有已证作用，不能用口头仙人身份无耗跨界。",
      "severity": "hard"
    },
    {
      "id": "immortal-text-and-technique-learning",
      "text": "银蝌文、金篆文与所记功法的学习分别发生；看见文字或持有残页不等于已能参悟、炼制或施展。修炼和仙家工艺仍须满足实际肉身神念、材料、法力和时间条件。",
      "severity": "hard"
    },
    {
      "id": "immortal-bounded-institutional-knowledge",
      "text": "仙界禁令属于机构规约，其执行者有感知、管辖和行动范围。角色的传闻、威胁、报价、库存声明和成功率估计不能直接写成客观世界事实；新证据可以改变认识。",
      "severity": "hard"
    }
  ],
